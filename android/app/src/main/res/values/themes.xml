<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.OdysPlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/noble_gold</item>
        <item name="colorPrimaryVariant">@color/cosmic_blue</item>
        <item name="colorOnPrimary">@color/metallic_blue</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/emerald_cyan</item>
        <item name="colorSecondaryVariant">@color/turquoise</item>
        <item name="colorOnSecondary">@color/dark_background</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/metallic_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/metallic_blue</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.OdysPlay.Splash" parent="Theme.OdysPlay">
        <item name="android:windowBackground">@color/cosmic_blue</item>
        <item name="android:statusBarColor">@color/cosmic_blue</item>
    </style>
</resources>
