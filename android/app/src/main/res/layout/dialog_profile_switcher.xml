<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alternar Perfil Ativo"
        android:textColor="@color/noble_gold"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sua conta OdysPlay permite alternar livremente entre suas personas sem deslogar:"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rgSwitchProfiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rbSwitchGamer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_metallic"
            android:padding="10dp"
            android:text="🎮 Modo Gamer (Social, Guildas, Feeds)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbSwitchDev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_metallic"
            android:padding="10dp"
            android:text="🛠️ Modo Dev (Portfólio de Jogos, Equipes)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbSwitchEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_metallic"
            android:padding="10dp"
            android:text="🏢 Modo Empresa (Game Jams, Vagas)"
            android:textColor="@color/text_primary" />

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelSwitch"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/noble_gold"
            android:text="Confirmar Troca"
            android:textColor="@color/metallic_blue"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
